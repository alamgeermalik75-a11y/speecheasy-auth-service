ENVIRONMENT=development
PORT=8001
HOST=0.0.0.0

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://fwrkrpmqmqxlgvyzrizq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT Security
JWT_SECRET_KEY=speecheasy_patient_jwt_secret_key_production_secure_min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Verification & Password Reset
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# Google Sign-In (Optional client ID check)
GOOGLE_CLIENT_ID=

# SMTP Configuration (Gmail, SendGrid, Amazon SES, or Mailgun)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@speecheasy.app
SMTP_FROM_NAME=SpeechEasy Patient Care
SMTP_USE_TLS=true

# Frontend & Backend URLs
FRONTEND_URL=speecheasy://app
BACKEND_URL=https://speecheasy-auth-service-production.up.railway.app

# CORS
CORS_ORIGINS=["*"]
